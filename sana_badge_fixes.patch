+
+  return qualifying
+    .map(({ s, badge }) => ({ key: String(s.id), label: s.fullName, meta: s.circleId ? circleNameById.get(s.circleId) : undefined, badge }))
+    .sort((a, b) => a.label.localeCompare(b.label, "ar"));
