+// خلال [from, to] — نستخدمها عشان نميّز "صفر غياب فعلي" عن "ما فيه إدخال بيانات أصلًا"
+async function circlesWithAnyRecord(circleIds: number[], from: string, to: string): Promise<Set<number>> {
+  const result = new Set<number>();
