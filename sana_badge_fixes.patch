+  /** سياق إضافي بين قوسين (مثل اسم الحلقة) */
+  meta?: string;
+}) {
+  const [imgFailed, setImgFailed] = useState(false);
+  const src = badge.thumb || badge.image;
+
+  return (
+    <div className="inline-flex flex-col items-center text-center gap-1 w-[104px]">
+      {src && !imgFailed ? (
